#!/usr/bin/env bash
set -u
BASE="/opt/linux-router"
STATE="$BASE/data/router_state.json"
LOG="/var/log/nanotechrouter-restore.log"
exec >>"$LOG" 2>&1
echo "===== $(date -Is) NanotechRouter safe restore ====="
[[ -f "$STATE" ]] || exit 1
sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
mapfile -t LANS < <(jq -r '.lans | keys[]?' "$STATE")
for IFACE in "${LANS[@]}"; do
  ip link show "$IFACE" >/dev/null 2>&1 || continue
  ADDR="$(jq -r --arg i "$IFACE" '.lans[$i].address // empty' "$STATE")"
  DHCP="$(jq -r --arg i "$IFACE" '.lans[$i].dhcp // false' "$STATE")"
  ip link set "$IFACE" up || true
  if [[ -n "$ADDR" ]] && ! ip -o -4 addr show dev "$IFACE" | awk '{print $4}' | grep -Fxq "$ADDR"; then
    echo "Restaurando $ADDR em $IFACE"
    ip addr add "$ADDR" dev "$IFACE" || true
  fi
  if [[ "$DHCP" == "true" ]]; then
    CONF="$BASE/config/dnsmasq/$IFACE.conf"
    if [[ -f "$CONF" ]] && ! pgrep -af "dnsmasq.*${IFACE}\.conf" >/dev/null 2>&1; then
      mkdir -p /run/linux-router "$BASE/data"
      dnsmasq --test --conf-file="$CONF" && dnsmasq --conf-file="$CONF" || true
    fi
  fi
done
for _ in $(seq 1 20); do
  curl -fsS http://127.0.0.1:5050/health >/dev/null 2>&1 && break
  sleep 1
done
if curl -fsS http://127.0.0.1:5050/health >/dev/null 2>&1; then
  curl -fsS -X POST http://127.0.0.1:5050/api/system/reapply || true
fi
for IFACE in "${LANS[@]}"; do ip -br -4 addr show "$IFACE" 2>/dev/null || true; done
